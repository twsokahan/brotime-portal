  "todo": [
    {
      "when": "2 週前",
      "task": "跟同行的成員約好日期和分館",
      "detail": "先上官網確認開館日和現在的展覽：週二至週日 9:30–17:00 開放、週一休館，換展期間可能閉館，以學會公告為準。挑離大家最近的一館，各館地址和交通在這頁下面的「選分館」。"
    },
    {
      "when": "2 週前",
      "task": "各自邀朋友或很久沒見的兄弟",
      "detail": "讓對方安心：進去各看各的，不用懂藝術，不用上台、不必發言。講清楚哪一天、在哪裡集合、大概幾點回到家；門票免費，吃飯、喝咖啡各自負擔，可以帶家人小朋友。很久沒見的兄弟：就是出來走走，不順便約其他聚會。給新朋友、給很久沒見的兄弟的訊息範本在企劃案附件六。"
    },
    {
      "when": "2 週前",
      "task": "借好《新・人間革命》第5卷",
      "detail": "故事卡在《新・人間革命》第5卷〈開道〉，當天帶這一本；手邊沒有就跟區裡借。"
    },
    {
      "when": "前幾天",
      "task": "確認人數，有帶小朋友的說一聲",
      "detail": "確認集合時間。小朋友也算進人數，挑店時才坐得下。"
    },
    {
      "when": "前幾天",
      "task": "挑好看完要去坐的地方",
      "detail": "館內有交流區的可以在館內坐（不是每館都有）；沒有的話，「選分館」裡有附近的店。各店公休日不同，挑分館開館那天也有營業的，營業時間以 Google 地圖為準。"
    },
    {
      "when": "前一天",
      "task": "發提醒訊息，附上分館地址",
      "detail": "開車的說好停哪裡；看完去哪裡坐、大約幾點結束也說一聲。出發前再上官網看一下當天有開館。訊息範本在企劃案附件六。"
    }
